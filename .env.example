# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# =============================================================================
# Automação — Google Sheets Webhook
# =============================================================================
# Secret compartilhado entre o script do Google Sheets e o webhook da API.
# Gere com: openssl rand -hex 32
SHEETS_WEBHOOK_SECRET=seu_secret_aqui

# =============================================================================
# WhatsApp Server
# =============================================================================
# URL do whatsapp-server.js em produção (ex: http://seu-servidor:3001)
# Em desenvolvimento, o padrão http://localhost:3001 é usado automaticamente.
WHATSAPP_SERVER_URL=http://localhost:3001

# Porta interna do servidor WhatsApp (usada no Docker)
WHATSAPP_SERVER_PORT=3001

# =============================================================================
# Google Analytics 4
# =============================================================================
GOOGLE_GA4_PROPERTY_ID=000000000
# JSON da Service Account com permissão de leitura na propriedade GA4
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# =============================================================================
# Cloudflare R2 — Biblioteca de Mídia (backups, arquivos grandes)
# =============================================================================
# Acesso S3-compatible. Tudo é usado APENAS no servidor (API routes); nunca expor
# no frontend. URLs públicas são geradas como signed URLs com expiração.
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
R2_BUCKET=biblioteca89-media
# Prefixo opcional limita listagem/upload a uma "pasta" do bucket (manter o "/").
R2_PREFIX=libmedia/
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# SMTP — Hostinger (envio de códigos de verificação do signup do admin)
# =============================================================================
# Hostinger: smtp.hostinger.com / 465 (SSL) ou 587 (STARTTLS).
# SMTP_USER deve ser uma mailbox real (ex: contato@formuladoboi.com).
# SMTP_PASS é a senha da mailbox configurada no painel do Hostinger.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@formuladoboi.com
SMTP_PASS=sua_senha_da_mailbox
# Opcional: nome de exibição. Se omitido, usa "Fórmula do Boi <SMTP_USER>".
SMTP_FROM=Fórmula do Boi <contato@formuladoboi.com>

# =============================================================================
# ClickSign — Assinatura eletrônica de contratos
# =============================================================================
# Token gerado no painel ClickSign (Configurações → API). Formato UUID.
# Em produção use https://app.clicksign.com/api/v1; em sandbox, https://sandbox.clicksign.com/api/v1
CLICKSIGN_ACCESS_TOKEN=00000000-0000-0000-0000-000000000000
CLICKSIGN_API_URL=https://app.clicksign.com/api/v1
# Opcional: HMAC SHA256 configurado no webhook do ClickSign para validar payloads.
CLICKSIGN_HMAC_SECRET=

# =============================================================================
# PostHog — Product Analytics + Session Replay + Web Analytics
# =============================================================================
# Project token (publicado no client). Padrão usado em produção: US Cloud.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Project ID — usado pelas server queries (HogQL via Personal API Key, opcional).
POSTHOG_PROJECT_ID=000000
# Personal API Key (opcional). Necessária só para o painel /web-admin/analytics
# fazer queries HogQL no PostHog. Crie em https://us.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=
